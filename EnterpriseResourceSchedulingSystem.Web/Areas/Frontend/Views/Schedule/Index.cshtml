@using Microsoft.AspNetCore.Authorization
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "排程主頁";
    var canManage = (await AuthorizationService.AuthorizeAsync(User, EnterpriseResourceSchedulingSystem.Web.Security.AuthorizationPolicies.BackendAccess)).Succeeded;
}

@section Styles {
    <link rel="stylesheet" href="~/css/frontend/scheduler.css" asp-append-version="true" />
}

<main id="frontendScheduler" class="frontend-scheduler" data-schedule-url="@Url.Content("~/api/schedule")" aria-label="企業資源排程">
    <aside class="scheduler-sidebar" aria-label="設備與人員條件">
        <div class="scheduler-sidebar-heading">
            <h1>排程篩選</h1>
        </div>

        <div class="scheduler-filter-scroll">
            <div class="accordion scheduler-filter-accordion" id="scheduleFilterAccordion" aria-label="排程條件">
                <section class="accordion-item scheduler-filter-item">
                    <h2 class="accordion-header" id="resourceFilterTitle">
                        <button class="accordion-button scheduler-accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#resourceFilterPanel" aria-expanded="true" aria-controls="resourceFilterPanel">
                            <span class="scheduler-filter-icon"><i class="bi bi-building-gear" aria-hidden="true"></i></span>
                            <span class="scheduler-accordion-title">設備條件</span>
                            <span id="resourceFilterCount" class="scheduler-count" aria-live="polite">0 / 0</span>
                        </button>
                    </h2>
                    <div id="resourceFilterPanel" class="accordion-collapse collapse show" aria-labelledby="resourceFilterTitle" data-bs-parent="#scheduleFilterAccordion">
                        <div class="accordion-body scheduler-accordion-body">
                            <label class="scheduler-search">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input id="resourceSearch" type="search" placeholder="搜尋設備或資源" autocomplete="off" aria-label="搜尋設備或資源" />
                            </label>
                            <div class="scheduler-filter-actions">
                                <button type="button" data-select-group="resources" data-select-action="all">全選</button>
                                <button type="button" data-select-group="resources" data-select-action="none">清除</button>
                            </div>
                            <div id="resourceFilterList" class="scheduler-option-list" role="group" aria-label="設備資源條件" aria-busy="true"></div>
                        </div>
                    </div>
                </section>

                <section class="accordion-item scheduler-filter-item">
                    <h2 class="accordion-header" id="peopleFilterTitle">
                        <button class="accordion-button scheduler-accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#peopleFilterPanel" aria-expanded="false" aria-controls="peopleFilterPanel">
                            <span class="scheduler-filter-icon scheduler-filter-icon-people"><i class="bi bi-people" aria-hidden="true"></i></span>
                            <span class="scheduler-accordion-title">人員條件</span>
                            <span id="peopleFilterCount" class="scheduler-count" aria-live="polite">0 / 0</span>
                        </button>
                    </h2>
                    <div id="peopleFilterPanel" class="accordion-collapse collapse" aria-labelledby="peopleFilterTitle" data-bs-parent="#scheduleFilterAccordion">
                        <div class="accordion-body scheduler-accordion-body">
                            <label class="scheduler-search">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input id="peopleSearch" type="search" placeholder="搜尋人員姓名或身分別" autocomplete="off" aria-label="搜尋人員姓名或身分別" />
                            </label>
                            <div class="scheduler-filter-actions">
                                <button type="button" data-select-group="people" data-select-action="all">全選</button>
                                <button type="button" data-select-group="people" data-select-action="none">清除</button>
                            </div>
                            <div id="peopleFilterList" class="scheduler-option-list" role="group" aria-label="人員條件" aria-busy="true"></div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </aside>

    <section class="scheduler-calendar-column" aria-label="排程日曆">
        <div class="scheduler-calendar-card">
            <label id="calendarIntervalControl" class="scheduler-interval-control" hidden>
                <span class="visually-hidden">時間間隔</span>
                <select id="calendarInterval" class="form-select form-select-sm">
                    <option value="5">5 分鐘／格</option>
                    <option value="10">10 分鐘／格</option>
                    <option value="15">15 分鐘／格</option>
                    <option value="30" selected>30 分鐘／格</option>
                </select>
            </label>
            <div id="scheduleCalendar" aria-label="資源排程日曆"></div>
            <div id="calendarLoadMessage" class="calendar-load-message" role="status" hidden></div>
        </div>
    </section>

    <aside class="scheduler-information" aria-label="排程資料">
        <div class="scheduler-tabs @(canManage ? "scheduler-tabs-manage" : "")" role="tablist" aria-label="排程操作">
            @if (canManage)
            {
                <button class="scheduler-tab is-active" id="slotCreateTab" type="button" role="tab" aria-selected="true" aria-controls="slotCreatePanel" data-scheduler-tab="slotCreatePanel">建立時間格</button>
            }
            <button class="scheduler-tab @(!canManage ? "is-active" : "")" id="scheduleInfoTab" type="button" role="tab" aria-selected="@(!canManage ? "true" : "false")" aria-controls="scheduleInfoPanel" tabindex="@(canManage ? -1 : 0)" data-scheduler-tab="scheduleInfoPanel">排程資料</button>
            <button class="scheduler-tab" id="personInfoTab" type="button" role="tab" aria-selected="false" aria-controls="personInfoPanel" tabindex="-1" data-scheduler-tab="personInfoPanel">人員資訊</button>
            <button class="scheduler-tab" id="resourceInfoTab" type="button" role="tab" aria-selected="false" aria-controls="resourceInfoPanel" tabindex="-1" data-scheduler-tab="resourceInfoPanel">設備資訊</button>
        </div>
        <div class="scheduler-tab-content">
            @if (canManage)
            {
                <section id="slotCreatePanel" class="scheduler-tab-panel" role="tabpanel" aria-labelledby="slotCreateTab">
                    <div class="scheduler-panel-row">
                        <label class="form-label" for="slotDropResource">新增至設備</label>
                        <select id="slotDropResource" class="form-select" disabled>
                            <option value="">請選擇設備</option>
                        </select>
                    </div>
                    <form id="slotTemplateForm" class="scheduler-panel-row">
                        <label class="form-label" for="slotTemplateMinutes">自訂分鐘數</label>
                        <div class="scheduler-panel-action">
                            <input id="slotTemplateMinutes" class="form-control" type="number" min="5" max="720" step="5" value="30" required />
                            <button class="btn btn-success text-nowrap" type="submit">更新自訂格</button>
                        </div>
                    </form>
                    <div id="slotTemplates" class="scheduler-slot-templates" aria-label="可拖曳的空白時段">
                        <div id="customSlotTemplate" class="scheduler-slot-template" data-minutes="30">＋ 自訂 30 分鐘空白時間</div>
                        @foreach (var minutes in new[] { 30, 60, 90, 120 })
                        {
                            <div class="scheduler-slot-template" data-minutes="@minutes">＋ @minutes 分鐘空白時間</div>
                        }
                    </div>
                    <ul class="scheduler-calendar-legend" aria-label="時段狀態圖例">
                        <li class="scheduler-slot-open">空白時間</li>
                        <li class="scheduler-slot-booked">已預約</li>
                        <li class="scheduler-slot-completed">已完成</li>
                        <li class="scheduler-slot-cancelled">已取消</li>
                    </ul>
                    <p id="slotDropFeedback" class="scheduler-panel-feedback" role="status"></p>
                </section>
            }
            <section id="scheduleInfoPanel" class="scheduler-tab-panel" role="tabpanel" aria-labelledby="scheduleInfoTab" hidden="@canManage">
                <p id="scheduleSlotDetail" class="scheduler-panel-empty">請點選日曆上的時間格。</p>
                <div id="scheduleSlotFields" hidden>
                    <div class="scheduler-panel-row"><label for="detailSlotId">排程單號</label><input id="detailSlotId" class="form-control" readonly /></div>
                    <div class="scheduler-panel-row"><label for="detailResource">設備</label><input id="detailResource" class="form-control" readonly /></div>
                    <div class="scheduler-panel-row"><label for="detailStatus">狀態</label><input id="detailStatus" class="form-control" readonly /></div>
                    <div class="scheduler-panel-row"><label for="detailDate">排程日期</label><input id="detailDate" class="form-control" type="date" readonly /></div>
                    <div class="scheduler-panel-row"><label for="detailStart">開始時間</label><input id="detailStart" class="form-control" type="time" readonly /></div>
                    <div class="scheduler-panel-row"><label for="detailEnd">結束時間</label><input id="detailEnd" class="form-control" type="time" readonly /></div>
                    <div class="scheduler-panel-row scheduler-panel-note">
                        <label for="detailBookedNames">已預約人員</label>
                        <textarea id="detailBookedNames" class="form-control" rows="2" readonly aria-live="polite"></textarea>
                    </div>
                    <div class="scheduler-panel-row"><label for="detailCapacity">預約名額</label><input id="detailCapacity" class="form-control" readonly /></div>
                    @if (canManage)
                    {
                        <form id="increaseSlotCapacityForm" class="scheduler-panel-row" hidden>
                            <label for="increaseSlotCapacity">增加名額</label>
                            <div class="scheduler-panel-action">
                                <input id="increaseSlotCapacity" class="form-control" type="number" required />
                                <button class="btn btn-outline-success text-nowrap" type="submit">更新名額</button>
                            </div>
                        </form>
                        <div id="bookScheduleSlot" class="scheduler-panel-row" hidden>
                            <label for="scheduleBookingUser">預約人員</label>
                            <select id="scheduleBookingUser" class="form-select"></select>
                        </div>
                    }
                    <div class="scheduler-panel-row scheduler-panel-note"><label for="detailNote">備註</label><textarea id="detailNote" class="form-control" rows="2" readonly></textarea></div>
                    @if (canManage)
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            <button id="saveScheduleBooking" class="btn btn-success flex-fill" type="button" hidden>儲存預約</button>
                            <button id="cancelScheduleSlot" class="btn btn-danger flex-fill" type="button" hidden>取消時段</button>
                        </div>
                    }
                </div>
                <p id="scheduleSlotFeedback" class="scheduler-panel-feedback" role="status"></p>
            </section>
            <section id="personInfoPanel" class="scheduler-tab-panel" role="tabpanel" aria-labelledby="personInfoTab" hidden>
                <p id="schedulePersonEmpty" class="scheduler-panel-empty">請先點選日曆上的時間格。</p>
                <ul id="schedulePersonFields" class="scheduler-booking-list" hidden></ul>
                @if (canManage)
                {
                    <section class="mt-3" id="scheduleBookingChanges" aria-labelledby="scheduleBookingChangesHeading" hidden>
                        <h3 class="h6" id="scheduleBookingChangesHeading">異動紀錄</h3>
                        <p id="scheduleBookingChangesStatus" class="scheduler-panel-empty" role="status"></p>
                        <ul id="scheduleBookingChangesList" class="scheduler-booking-list"></ul>
                    </section>
                }
                <p id="schedulePersonFeedback" class="scheduler-panel-feedback" role="status"></p>
            </section>
            <section id="resourceInfoPanel" class="scheduler-tab-panel" role="tabpanel" aria-labelledby="resourceInfoTab" hidden>
                <p id="scheduleResourceEmpty" class="scheduler-panel-empty">請先點選排程，或選擇新增時段所屬設備。</p>
                <div id="scheduleResourceFields" hidden></div>
                <section id="scheduleResourceFees" class="mt-3" aria-labelledby="scheduleResourceFeesHeading" hidden>
                    <h3 id="scheduleResourceFeesHeading" class="h6">身分費率</h3>
                    <p id="scheduleResourceFeesStatus" class="scheduler-panel-empty" role="status"></p>
                    <table id="scheduleResourceFeesTable" class="table table-sm mb-0" hidden>
                        <thead><tr><th scope="col">身分別</th><th scope="col" class="text-end">費率</th></tr></thead>
                        <tbody></tbody>
                    </table>
                </section>
            </section>
        </div>
    </aside>
</main>

@if (canManage)
{
    <div class="modal fade" id="scheduleSlotModal" tabindex="-1" aria-labelledby="scheduleSlotTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <form id="scheduleSlotForm" class="modal-content">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h2 id="scheduleSlotTitle" class="modal-title fs-5">新增時段</h2>
                    <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="關閉"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label d-block">設備
                        <select id="slotResource" class="form-select" required></select>
                    </label>
                    <label class="form-label d-block">日期
                        <input id="slotDate" class="form-control" type="date" required />
                    </label>
                    <label class="form-label d-block">適用版本
                        <select id="slotVersion" class="form-select" required></select>
                    </label>
                    <div class="d-flex gap-2">
                        <label class="form-label">開始時間
                            <input id="slotStart" class="form-control" type="time" required />
                        </label>
                        <label class="form-label">結束時間
                            <input id="slotEnd" class="form-control" type="time" required />
                        </label>
                    </div>
                    <label class="form-label d-block">名額
                        <input id="slotCapacity" class="form-control" type="number" min="1" required />
                    </label>
                    <label class="form-label d-block">備註
                        <textarea id="slotNote" class="form-control" maxlength="500" rows="2"></textarea>
                    </label>
                    <p id="slotFeedback" class="text-danger" role="status"></p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">關閉</button>
                    <button id="saveScheduleSlot" class="btn btn-success" type="submit">儲存</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script src="~/js/frontend/schedule.js" asp-append-version="true"></script>
}
