@{
    ViewData["Title"] = "前台首頁";
}

@section Styles {
    <link rel="stylesheet" href="~/css/frontend/home.css" asp-append-version="true" />
}

<main class="frontend-home" aria-labelledby="homeTitle">
    <section class="frontend-home-welcome">
        <div class="frontend-home-copy">
            <span class="frontend-home-eyebrow">ENTERPRISE RESOURCE SCHEDULING</span>
            <h1 id="homeTitle">企業資源排程系統</h1>
            <p>集中查看設備資源時段，快速掌握可預約名額與使用資訊。</p>
            <a asp-area="Frontend" asp-controller="Schedule" asp-action="Index" class="frontend-home-action">
                前往排程主頁 <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </div>
        <div class="frontend-home-illustration" aria-hidden="true">
            <div class="home-calendar-art"><i class="bi bi-calendar2-week"></i><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <div class="home-resource-art home-resource-art-one"><i class="bi bi-building"></i></div>
            <div class="home-resource-art home-resource-art-two"><i class="bi bi-tools"></i></div>
        </div>
    </section>

    <section class="frontend-home-shortcuts" aria-label="常用功能">
        <a asp-area="Frontend" asp-controller="Schedule" asp-action="Index" class="frontend-shortcut-card">
            <span class="frontend-shortcut-icon"><i class="bi bi-calendar-check" aria-hidden="true"></i></span>
            <span><strong>排程主頁</strong><small>瀏覽資源時段與預約資訊</small></span>
            <i class="bi bi-chevron-right frontend-shortcut-arrow" aria-hidden="true"></i>
        </a>
        <div class="frontend-shortcut-card frontend-shortcut-card-muted">
            <span class="frontend-shortcut-icon frontend-shortcut-icon-muted"><i class="bi bi-person-lines-fill" aria-hidden="true"></i></span>
            <span><strong>我的預約</strong><small>預約清單功能將於後續接續開發</small></span>
        </div>
    </section>
</main>
